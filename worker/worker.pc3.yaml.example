# =============================================================================
# Cấu hình mẫu Worker Host PC3 (BA & PO)
# Sao chép thành worker.yaml trên PC3 và cập nhật IP của PC1 nếu cần.
# =============================================================================

worker_id: "worker-pc3"
machine_id: "PC3"
control_url: "http://192.168.1.101:8000"
secret: "worker_pc3_secret_token_change_me"
listen_host: "0.0.0.0"
listen_port: 8000
contract_version: "1.3.0"
worker_version: "1.0.0"
heartbeat_interval_seconds: 10
outbox_db_path: "worker/data/outbox_pc3.db"

agents:
  - agent_id: "ba-01"
    role: "BA"
    name: "Business Analyst Agent"
    version: "1.0.0"
    path: "agents/ba"
    capabilities:
      - "write_requirements"
      - "write_user_stories"
      - "acceptance_criteria"
      - "requirements_analysis"
  - agent_id: "po-01"
    role: "PO"
    name: "Product Owner Agent"
    version: "1.0.0"
    path: "agents/po"
    capabilities:
      - "define_backlog"
      - "accept_release"
      - "scope_approval"
      - "release_validation"
