# =============================================================================
# Cấu hình mẫu Worker Host PC3 (PO & SA)
# =============================================================================

worker_id: "worker-pc3"
machine_id: "PC3"
control_url: "http://26.105.63.241:8000"
secret: "worker_pc3_secret_token_change_me"
listen_host: "0.0.0.0"
listen_port: 8001
contract_version: "1.3.0"
worker_version: "1.0.0"
heartbeat_interval_seconds: 10
outbox_db_path: "worker/data/outbox_pc3.db"

agents:
  - agent_id: "po-01"
    role: "PO"
    name: "Product Owner Agent"
    version: "1.0.0"
    path: "agents/po"
    capabilities:
      - "define_backlog"
      - "accept_release"
      - "scope_approval"
      - "release_validation"
  - agent_id: "sa-01"
    role: "SA"
    name: "Software Architect Agent"
    version: "1.0.0"
    path: "agents/sa"
    capabilities:
      - "design_architecture"
      - "system_architecture"
      - "tech_stack_selection"
      - "interface_design"
