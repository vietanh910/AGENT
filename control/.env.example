# =============================================================================
# Cấu hình mẫu cho Control Node (PC1) - ai-team
# Sao chép tệp này thành .env hoặc control/.env và điền các khóa bí mật.
# KHÔNG commit tệp .env chứa thông tin bí mật lên git repository!
# =============================================================================

# --- 1. Môi trường và Mạng của Control Node ---
# Môi trường chạy: development | staging | production
APP_ENV=development
# Địa chỉ IP bind cho Control Node Gateway. 0.0.0.0 cho phép các Worker PC2-PC5 trong LAN kết nối tới.
APP_HOST=0.0.0.0
# Cổng HTTP của Control Node Gateway
APP_PORT=8000

# --- 2. Cơ sở dữ liệu và Hàng đợi (MySQL 8.4 LTS & Redis) ---
# Kết nối SQLAlchemy đến MySQL (chạy nội bộ trên PC1 qua Docker Compose hoặc trực tiếp)
DATABASE_URL=mysql+pymysql://ai_user:ai_password_change_me@127.0.0.1:3306/ai_team?charset=utf8mb4
# Kết nối Redis dùng cho hàng đợi công việc, phân tán khóa (distributed lock) và luồng sự kiện
REDIS_URL=redis://127.0.0.1:6379/0

# Cấu hình container Docker Compose (nếu sử dụng docker-compose.yml trong control/)
MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=ai_team
MYSQL_USER=ai_user
MYSQL_PASSWORD=ai_password_change_me
MYSQL_PORT=3306
REDIS_PORT=6379

# --- 3. Cấu hình Large Language Model (LLM) ---
# Nhà cung cấp LLM: openai | azure | local | mock (chuẩn OpenAI API)
LLM_PROVIDER=openai
# Model LLM sử dụng cho PM Agent và các tác vụ sinh kế hoạch / nội dung
LLM_MODEL=gpt-4o-mini
# API Key của LLM provider
LLM_API_KEY=sk-placeholder-llm-api-key
# Endpoint tương thích OpenAI API (có thể trỏ sang Local LLM như Ollama / vLLM hoặc proxy)
LLM_BASE_URL=https://api.openai.com/v1

# --- 4. Tích hợp Linear (Bản phản chiếu công việc, không bao giờ chặn workflow) ---
# Personal API Key lấy từ Linear Settings > API > Personal API keys
LINEAR_API_KEY=lin_api_placeholder_key
# ID của Team trong Linear quản lý dự án (ví dụ UUID hoặc Team Key)
LINEAR_TEAM_ID=team_placeholder_id
# Chế độ chạy thử Linear: true = log thay vì gọi thật lên Linear API; false = gọi thật
LINEAR_DRY_RUN=true

# --- 5. Tích hợp GitHub (Quản lý mã nguồn, Pull Request, CI Staging) ---
# Personal Access Token của GitHub (cần quyền repo, workflow)
GITHUB_TOKEN=ghp_placeholder_github_token
# Định dạng owner/repo đích cho dự án phần mềm được bàn giao
GITHUB_REPOSITORY=vietanh910/AGENT

# --- 6. Bảo mật và Phân quyền ---
# Token quản trị (Bearer) để gọi các endpoint nhạy cảm: approve, reject, cancel, pause, resume
ADMIN_TOKEN=admin_secret_bearer_token_change_me

# --- 7. Quản lý Worker và Điều phối ---
# Đường dẫn tệp cấu hình danh sách các máy Worker (PC2..PC5)
WORKERS_FILE=configs/workers.yaml
# Thời gian timeout không nhận heartbeat từ Worker để xác định OFFLINE (giây)
HEARTBEAT_TIMEOUT_SECONDS=45
# Chế độ yêu cầu phê duyệt thủ công tại các cổng duyệt (gate: APPROVE_SCOPE, APPROVE_PROD)
APPROVAL_MODE=true
# Giới hạn tối đa số task được tạo và chạy trong một lần WorkflowRun (chống vòng lặp vô hạn)
MAX_TASKS_PER_RUN=60
# Giới hạn số lần lặp sửa lỗi tối đa giữa DEV và TESTER/SECURITY khi phát hiện lỗi
MAX_FIX_LOOPS=3
# Số task tối đa được phép dispatch chạy đồng thời qua các Worker
MAX_PARALLEL_TASKS=2
# Thời gian timeout tối đa cho một WorkflowRun (phút) trước khi bị đánh dấu FAILED/TIMEOUT
RUN_TIMEOUT_MINUTES=240
# Cờ an toàn cấm/cho phép thực hiện hành động deploy lên môi trường Production
ALLOW_PROD_DEPLOY=false
