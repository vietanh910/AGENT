{
  "$defs": {
    "AgentIdentity": {
      "description": "Thông tin nhận diện và năng lực tự khai báo của Agent.",
      "properties": {
        "contract_version": {
          "default": "1.3.0",
          "title": "Contract Version",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AgentStatus",
          "default": "IDLE"
        }
      },
      "required": [
        "agent_id",
        "role",
        "name",
        "version",
        "capabilities"
      ],
      "title": "AgentIdentity",
      "type": "object"
    },
    "AgentRole": {
      "description": "Vai trò của Agent trong đội ngũ phát triển phần mềm.",
      "enum": [
        "PM",
        "SA",
        "BA",
        "PO",
        "DEV",
        "TESTER",
        "DEVOPS",
        "DBA",
        "SCRUM_MASTER",
        "SECURITY"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AgentStatus": {
      "description": "Trạng thái hoạt động của Agent.",
      "enum": [
        "OFFLINE",
        "IDLE",
        "RUNNING",
        "WAITING",
        "COMPLETED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "AgentStatus",
      "type": "string"
    }
  },
  "description": "Bản tin đăng ký của Worker Host khi khởi động gửi tới PC1.",
  "properties": {
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    },
    "machine_id": {
      "title": "Machine Id",
      "type": "string"
    },
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentIdentity"
      },
      "title": "Agents",
      "type": "array"
    },
    "contract_version": {
      "default": "1.3.0",
      "title": "Contract Version",
      "type": "string"
    },
    "worker_version": {
      "default": "1.0.0",
      "title": "Worker Version",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "machine_id",
    "base_url",
    "agents"
  ],
  "title": "WorkerRegistration",
  "type": "object"
}
