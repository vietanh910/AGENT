HOST=0.0.0.0
PORT=8001
CONTRACT_MIN_VERSION=1.0.0
AGENT_ID=pm-01
AGENT_ROLE=PM
AGENT_API_KEY=
MAX_UPLOAD_MB=50
LLM_PROVIDER=groq            # groq | gemini | openrouter | ollama | openai | custom
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=                # để trống thì lấy theo preset của provider
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
DATA_DIR=./data
ALLOWED_COMMANDS=
DRY_RUN=true

# Cấu hình Conductor / Tự động hóa dự án (v1.1.0)
PM_AUTO_APPROVE=false
PM_PROJECT_MODE=managed
CONTROL_URL=http://127.0.0.1:8000
CONTROL_ADMIN_TOKEN=
PM_ALLOW_REAL_DEPLOY=false
MAX_FIX_LOOPS=3
MAX_TASKS_PER_PROJECT=60
PROJECT_TIMEOUT_MINUTES=240
